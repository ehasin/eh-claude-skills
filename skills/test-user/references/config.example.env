# test-user config: keep this file OUTSIDE any repo, or in a gitignored .env* file.
# Pass its path to /test-user as config=...

# The Gmail address the tester's Chrome profile is signed in to.
TEST_USER_GMAIL=your.tester@gmail.com

# Optional: the Claude in Chrome deviceId of the tester profile's browser.
# Get it from list_connected_browsers. Without it, you're asked to pick when several browsers are connected.
TEST_USER_CHROME_DEVICE_ID=
