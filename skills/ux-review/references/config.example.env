# ux-review config: keep this file OUTSIDE any repo, or in a gitignored .env* file.
# Pass its path to /ux-review as config=...
# Use a dedicated test account, never a real person's account.

# The app's own email/password sign-in for the test account.
UX_REVIEW_EMAIL=reviewer@example.com
UX_REVIEW_PASSWORD=

# Optional: the Claude in Chrome deviceId of the browser to use.
# Get it from list_connected_browsers. Without it, you're asked to pick when several browsers are connected.
UX_REVIEW_CHROME_DEVICE_ID=
